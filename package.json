{
  "name": "server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/Main.js",
    "dev": "tsx watch --env-file-if-exists=.env src/Main.ts",
    "db:generate": "npx drizzle-kit generate",
    "db:push": "npx drizzle-kit push",
    "db:migrate": "npx tsx ./src/Migrate.ts",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@effect/platform": "^0.97.1",
    "@effect/platform-node": "^0.108.1",
    "@paralleldrive/cuid2": "^2.2.2",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.7.10",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.30.10",
    "effect": "^3.22.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.4.4",
    "ping": "^0.4.4",
    "postgres": "^3.4.4",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@effect/vitest": "^0.30.0",
    "@eslint/js": "^9.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/luxon": "^3.4.2",
    "@types/node": "20.12.12",
    "@types/ping": "^0.4.4",
    "drizzle-kit": "^0.21.4",
    "eslint": "^9.3.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "8.68.0",
    "vitest": "^3.2.0"
  }
}
